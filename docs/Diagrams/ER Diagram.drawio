        <UserObject label="" mermaidData="{&quot;data&quot;: &quot;flowchart TD     %% ==========================================     %% GLOBAL STYLING (Chen's ER Formal Standard)     %% ==========================================     classDef entity fill:#1E293B,stroke:#38BDF8,stroke-width:2px,color:#F8FAFC,font-weight:bold,font-size:13px;     classDef relation fill:#312E81,stroke:#818CF8,stroke-width:2px,color:#EEF2FF,font-weight:bold,font-size:11px;     classDef attr fill:#0F172A,stroke:#64748B,stroke-width:1px,color:#E2E8F0,font-size:10px;     classDef keyAttr fill:#0F172A,stroke:#F59E0B,stroke-width:1.5px,color:#FDE68A,font-weight:bold,font-size:10px;      %% ==========================================     %% ENTITY MODULES &amp; CHEN ATTRIBUTES     %% ==========================================      subgraph SG_USER [\&quot; USER DOMAIN MODULE \&quot;]         direction TB         E_USER[\&quot;USER\&quot;]:::entity         A_U1([\&quot;user_id (PK)\&quot;]):::keyAttr         A_U2([\&quot;username\&quot;]):::attr         A_U3([\&quot;email\&quot;]):::attr         A_U4([\&quot;role\&quot;]):::attr         A_U5([\&quot;reliability_score\&quot;]):::attr         A_U6([\&quot;is_banned\&quot;]):::attr         E_USER --- A_U1         E_USER --- A_U2         E_USER --- A_U3         E_USER --- A_U4         E_USER --- A_U5         E_USER --- A_U6     end      subgraph SG_LOBBY [\&quot; LOBBY DOMAIN MODULE \&quot;]         direction TB         E_LOBBY[\&quot;LOBBY\&quot;]:::entity         A_L1([\&quot;lobby_id (PK)\&quot;]):::keyAttr         A_L2([\&quot;title\&quot;]):::attr         A_L3([\&quot;description\&quot;]):::attr         A_L4([\&quot;status\&quot;]):::attr         A_L5([\&quot;max_capacity\&quot;]):::attr         A_L6([\&quot;location\&quot;]):::attr         E_LOBBY --- A_L1         E_LOBBY --- A_L2         E_LOBBY --- A_L3         E_LOBBY --- A_L4         E_LOBBY --- A_L5         E_LOBBY --- A_L6     end      subgraph SG_TAXONOMY [\&quot; TAXONOMY MODULE \&quot