    <mxGraphModel grid="0" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    %% ============ ACTORS ============\n    Guest((\&quot;👤 Guest\&quot;))\n    Member((\&quot;👤 Member\&quot;))\n    Host((\&quot;👑 Lobby Host\&quot;))\n    Admin((\&quot;🛡️ Admin\&quot;))\n\n    %% ============ SYSTEM BOUNDARY ============\n    subgraph FindMate_System [\&quot; FINDMATE SYSTEM BOUNDARY \&quot;]\n        direction TB\n\n        subgraph Sub_Auth [\&quot; 1. Auth &amp; Profile \&quot;]\n            UC_Auth([\&quot;Authenticate (Sign In / Sign Up)\&quot;])\n            UC_Profile([\&quot;Manage Profile &amp; Linked Accounts\&quot;])\n            UC_Tags([\&quot;Select Interest Tags\&quot;])\n        end\n\n        subgraph Sub_Lobby [\&quot; 2. Lobby &amp; Discovery \&quot;]\n            UC_Browse([\&quot;Browse &amp; Filter Lobbies\&quot;])\n            UC_ViewLobby([\&quot;View Lobby Details\&quot;])\n            UC_CreateLobby([\&quot;Create &amp; Publish Lobby\&quot;])\n            UC_ManageLobby([\&quot;Update Lobby Status\&quot;])\n        end\n\n        subgraph Sub_App [\&quot; 3. Team-up &amp; Applications \&quot;]\n            UC_Apply([\&quot;Apply to Join Lobby\&quot;])\n            UC_ReviewApps([\&quot;Review Applicants\&quot;])\n            UC_Accept([\&quot;Accept Applicant\&quot;])\n            UC_Decline([\&quot;Decline Applicant\&quot;])\n        end\n\n        subgraph Sub_Comm [\&quot; 4. Communication \&quot;]\n            UC_GroupChat([\&quot;Participate in Lobby Group Chat\&quot;])\n            UC_DM([\&quot;Send 1-on-1 Direct Messages\&quot;])\n            UC_Notifs([\&quot;View Notifications\&quot;])\n        end\n\n        subgraph Sub_Admin [\&quot; 5. Moderation &amp; Tags \&quot;]\n            UC_Report([\&quot;Report Lobby or User\&quot;])\n            UC_ReviewReports([\&quot;Review &amp; Resolve Reports\&quot;])\n            UC_ManageTags([\&quot;Manage Platform Tags\&quot;])\n        end\n    end\n\n    %% ============ GUEST ============\n    Guest --&gt; UC_Auth\n    Guest --&gt; UC_Browse\n\n    %% ============ MEMBER ============\n    Member --&gt; UC_Profile\n    Member --&gt; UC_Tags\n    Member --&gt; UC_Browse\n    Member --&gt; UC_ViewLobby\n    Member --&gt; UC_Apply\n    Member --&gt; UC_GroupChat\n    Member --&gt; UC_DM\n    Member --&gt; UC_Notifs\n    Member --&gt; UC_Report\n\n    %% ============ HOST (generalization: Host is-a Member) ============\n    Host --&gt; Member\n    Host --&gt; UC_CreateLobby\n    Host --&gt; UC_ManageLobby\n    Host --&gt; UC_ReviewApps\n\n    %% ============ INCLUDE RELATIONSHIPS ============\n    UC_ReviewApps -.-&gt;|\&quot;«include»\&quot;| UC_Accept\n    UC_ReviewApps -.-&gt;|\&quot;«include»\&quot;| UC_Decline\n\n    %% ============ ADMIN ============\n    Admin --&gt; UC_ReviewReports\n    Admin --&gt; UC_ManageTags\n\n    %% ============ STYLING ============\n    classDef actor fill:#2C3E50,stroke:#1A252F,stroke-width:2px,color:#fff,font-weight:bold\n    classDef usecase fill:#EAF2F8,stroke:#2E86C1,stroke-width:1.5px,color:#1B2631\n    classDef boundary fill:#F8F9F9,stroke:#B2BABB,stroke-width:2px,color:#1B2631\n\n    class Guest,Member,Host,Admin actor\n    class UC_Auth,UC_Profile,UC_Tags,UC_Browse,UC_ViewLobby,UC_CreateLobby,UC_ManageLobby,UC_Apply,UC_ReviewApps,UC_Accept,UC_Decline,UC_GroupChat,UC_DM,UC_Notifs,UC_Report,UC_ReviewReports,UC_ManageTags usecase\n    class Sub_Auth,Sub_Lobby,Sub_App,Sub_Comm,Sub_Admin boundary&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="f5NgsPglpvljf8JPAGvW-96">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
