VERSION=1.0.0
SERVICE_NAME=findmate-backend
HTTP_PORT=8080
JWT_SECRET_KEY=findmate_secure_jwt_secret_key_2026

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=findmate
DB_USER=postgres
DB_PASSWORD=add_your_password
DB_SSL_MODE=disable

# OAuth 2.0 Credentials (Google, Discord, LinkedIn)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5173/auth/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:5173/auth/callback

# Email / SMTP Configuration (e.g. Gmail, SendGrid, Brevo, Mailtrap)
# For Gmail:
# 1. Go to Google Account -> Security -> 2-Step Verification
# 2. At bottom, create an "App password" for Mail
# 3. Enter your Gmail in SMTP_USER and SMTP_FROM, and the 16-letter App password in SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
